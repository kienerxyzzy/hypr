#today we test
#RECURSION
call main
jmp @halt

function abacaba
takes N K
	if N==0
		return ""
	endc
	var result
	var temp
	push N#As of now, Hypr doesn't preserve vars
	push K
	call abacaba N-1 K//2
	retrieve temp
	pop K
	pop N#So we'll have to preserve 'em manually
	result=temp+" "+K+" "+temp
return result
endf

function main
	var N
	N=5
	var result
	call abacaba N 16
	retrieve result
	push result
	invoke print
return
endf

@halt