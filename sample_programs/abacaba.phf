#today we test
#RECURSION
call main
jmp @halt

function abacaba
takes N K
	preserve N K
	if N==0
		return ""
	endc
	var result temp
	call abacaba N-1 K//2
	retrieve temp
	result=temp+" "+K+" "+temp
return result
endf

function main
	var N
	N=5
	var result
	call abacaba N 16
	retrieve result
	push result
	invoke print
return
endf

@halt